# Compiled Object files
*.slo
*.lo
*.o
*.obj

# Precompiled Headers
*.gch
*.pch

# Compiled Dynamic libraries
*.so
*.dylib
*.dll

# Fortran module files
*.mod

# Compiled Static libraries
*.lai
*.la
*.a
*.lib

# Executables
*.exe
*.out
*.app

# Build directories
build/
core/build/
core/build-*/
ns3/build/
*.cmake
CMakeCache.txt
CMakeFiles/

# Rendered docs site (`mkdocs build` default site_dir; CI publishes it, the
# repo never carries it — see mkdocs.yml, #331)
site/

# Coverage output (gcov counters + gcovr reports)
coverage/
*.gcda
*.gcno
*.gcov

# Simulator trace output
*.tr
*.nam
rtable.txt

# Python bytecode (ns3/tools/*.py, .claude/skills/*.py)
__pycache__/
*.pyc

# Agent worktrees (Claude Code `isolation: worktree`). Each entry is a full
# checkout of this repo created for a subagent to work in isolation, so it must
# never be committed into the repo it is a copy of.
.claude/worktrees/
